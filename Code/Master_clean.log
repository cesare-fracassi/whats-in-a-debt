. * Spread rating variables for all time periods (needed for fixed effects)
. foreach x of varlist TMJunk TMIG TMoodyIGboundary aboveIGboundary belowIGboundary SPIGboundary
>  SPJunk SPIG SPnegoutlook - SPdevwatch SPRated {
  2.     egen max`x' = max(`x'), by(gvkey)
  3.     replace `x' = max`x'
  4.     drop max`x'
  5.     replace `x' = 0 if missing(`x')
  6. }
