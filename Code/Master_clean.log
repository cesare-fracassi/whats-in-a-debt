. program define ffind
  1.         version 9.2
  2.         syntax varlist(min=1 max=1 numeric) [if] [in], newvar(string) type(numlist max=1 mi
> n=1)
  3. 
.         tempvar ftyp
  4.         tokenize "`type'"
  5.         local `ftyp'=`1'
  6.         
.         * Check if newvar is valid variable name
.         capture confirm new variable `newvar'
  7.         if _rc != 0 {
  8.                 di as error "Variable `newvar' is invalid"
  9.                 exit 111
 10.                 }
 11. 
.         * Check type
.         if ~inlist(``ftyp'',5,10,12,17,30,38,48,49) {
 12.                 di as error "Type must be 5, 10, 12, 17, 30, 38, 48 or 49"
